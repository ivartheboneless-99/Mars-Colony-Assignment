<mxfile host="app.diagrams.net">
  <diagram id="20CyuxXN9gES4X8XWVG6" name="classDiagram">
    <mxGraphModel dx="3826" dy="2853" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam packageStyle rectangle\nleft to right direction\n\npackage \&quot;Module 1: Agents &amp; Environment\&quot; {\n    enum Capability {\n        SCIENTIFIC_RESEARCH\n        ENGINEERING_REPAIR\n        MEDICAL_CARE\n        SURFACE_EXPLORATION\n        AERIAL_RECON\n    }\n    \n    enum EnvironmentCondition {\n        NORMAL\n        DUST_STORM\n        COMMUNICATION_DISRUPTION\n    }\n    \n    class Environment {\n        - condition: EnvironmentCondition\n        + getCondition(): EnvironmentCondition\n        + allowsSurfaceOperations(): boolean\n        + allowsRemoteCommunication(): boolean\n    }\n    \n    class Location {\n        - name: String\n        - isSurface: boolean\n    }\n    \n    abstract class Agent {\n        - id: String\n        - location: Location\n        - isAssigned: boolean\n        + isUsable(): boolean\n        + canPerform(m: Mission): boolean\n        + canRespondTo(e: Emergency): boolean\n        + onTimeStep(): void\n    }\n    \n    abstract class CrewMember {\n        - name: String\n        - health: int\n        - fatigue: int\n        - skills: List&lt;Capability&gt;\n    }\n    \n    abstract class RoboticUnit {\n        - batteryLevel: int\n        - isDamaged: boolean\n    }\n    \n    class Scientist\n    class Engineer\n    class MedicalOfficer\n    class ExplorationRover\n    class RepairRobot\n    class Drone\n    \n    Agent &lt;|-- CrewMember : \&quot;Inheritance\&quot;\n    Agent &lt;|-- RoboticUnit : \&quot;Inheritance\&quot;\n    CrewMember &lt;|-- Scientist\n    CrewMember &lt;|-- Engineer\n    CrewMember &lt;|-- MedicalOfficer\n    RoboticUnit &lt;|-- ExplorationRover\n    RoboticUnit &lt;|-- RepairRobot\n    RoboticUnit &lt;|-- Drone\n}\n\npackage \&quot;Module 2: Facilities &amp; Resources (Member 2)\&quot; {\n    enum ResourceType {\n        OXYGEN\n        WATER\n        FOOD\n        FUEL\n        BATTERY_POWER\n        MEDICAL_SUPPLIES\n        SPARE_PARTS\n    }\n    \n    class Equipment {\n        - equipmentId: String\n        - name: String\n        - capability: String\n        - damaged: boolean\n        + getEquipmentId(): String\n        + getName(): String\n        + getCapability(): String\n        + isDamaged(): boolean\n        + damage(): void\n        + repair(): void\n        + canPerform(requiredCapability: String): boolean\n    }\n    \n    class LifeSupportSystem {\n        - oxygenCirculation: boolean\n        - airFiltration: boolean\n        + isOxygenCirculation(): boolean\n        + isAirFiltration(): boolean\n        + stopOxygenCirculation(): void\n        + stopAirFiltration(): void\n        + repair(): void\n        + isOperational(): boolean\n    }\n    \n    abstract class Facility {\n        - facilityId: String\n        - location: String\n        - capacity: int\n        - operational: boolean\n        - equipment: ArrayList&lt;Equipment&gt;\n        - resources: Map&lt;ResourceType, Integer&gt;\n        + getFacilityId(): String\n        + getLocation(): String\n        + getCapacity(): int\n        + isOperational(): boolean\n        + setOperational(operational: boolean): void\n        + addEquipment(item: Equipment): void\n        + getEquipment(): List&lt;Equipment&gt;\n        + hasWorkingEquipment(capability: String): boolean\n        + getResourceQuantity(type: ResourceType): int\n        + getResources(): Map&lt;ResourceType, Integer&gt;\n        + addResource(type: ResourceType, quantity: int): void\n        + consumeResource(type: ResourceType, quantity: int): boolean\n        # loseLocalResource(type: ResourceType, quantity: int): int\n    }\n    \n    class Habitat {\n        - lifeSupport: LifeSupportSystem\n        + isLifeSupportOperational(): boolean\n        + stopOxygenCirculation(): void\n        + stopAirFiltration(): void\n        + repairLifeSupport(): void\n        + applyOxygenLeak(quantity: int): int\n    }\n    \n    class Laboratory {\n        + canConductResearch(): boolean\n    }\n    \n    class PowerStation {\n        + getAvailablePower(): int\n        + hasSufficientPower(requiredPower: int): boolean\n    }\n    \n    class StorageFacility {\n    }\n    \n    class CommunicationStation {\n        - communicationEnabled: boolean\n        + canCommunicate(): boolean\n        + disableCommunication(): void\n        + enableCommunication(): void\n    }\n    \n    class ResourceManager {\n        - facilities: List&lt;Facility&gt;\n        + addFacility(facility: Facility): void\n        + getFacilities(): List&lt;Facility&gt;\n        + getTotalResource(type: ResourceType): int\n        + getAllResourceTotals(): Map&lt;ResourceType, Integer&gt;\n        - validateRequest(request: Map&lt;ResourceType, Integer&gt;): void\n        + hasEnoughResources(request: Map&lt;ResourceType, Integer&gt;): boolean\n        + consumeResources(request: Map&lt;ResourceType, Integer&gt;): boolean\n        + getShortageReason(request: Map&lt;ResourceType, Integer&gt;): String\n    }\n    \n    Facility &lt;|-- Habitat\n    Facility &lt;|-- Laboratory\n    Facility &lt;|-- StorageFacility\n    Facility &lt;|-- PowerStation\n    Facility &lt;|-- CommunicationStation\n    \n    Habitat *-- LifeSupportSystem : \&quot;Composition\&quot;\n    Facility o-- Equipment : \&quot;Aggregation\&quot;\n    ResourceManager o-- Facility : \&quot;Aggregation\&quot;\n}\n\npackage \&quot;Module 3: Missions &amp; Simulation\&quot; {\n    enum MissionState {\n        CREATED\n        ASSIGNED\n        IN_PROGRESS\n        COMPLETED\n        FAILED\n    }\n    \n    abstract class Mission {\n        - id: String\n        - state: MissionState\n        - duration: int\n        - elapsedTime: int\n        - requiredAgents: List&lt;Agent&gt;\n        + advanceTime(): void\n    }\n    \n    class ExplorationMission\n    class RepairMission\n    class ResearchMission\n    class RescueMission\n    \n    class Simulation {\n        - clock: int\n        + advanceTime(units: int): void\n    }\n    \n    class MarsColony {\n        - activeMission: Mission\n        + submitMission(m: Mission): void\n        + generateReport(): void\n    }\n    \n    Mission &lt;|-- ExplorationMission\n    Mission &lt;|-- RepairMission\n    Mission &lt;|-- ResearchMission\n    Mission &lt;|-- RescueMission\n    \n    MarsColony o-- Agent : \&quot;Aggregation\&quot;\n    MarsColony --&gt; Mission : \&quot;Association\&quot;\n}\n\npackage \&quot;Module 4: Emergencies &amp; Master\&quot; {\n    enum EmergencyStatus {\n        PENDING\n        RESOLVED\n        UNRESOLVED\n    }\n    \n    abstract class Emergency {\n        - id: String\n        - location: Location\n        - status: EmergencyStatus\n        + resolve(): void\n    }\n    \n    class OxygenLeakEmergency\n    class FireEmergency\n    class RoverBreakdownEmergency\n    class MedicalEmergency\n    \n    class EmergencyManager {\n        + handleEmergency(e: Emergency): void\n    }\n    \n    class Main {\n        + runScenarios(): void\n    }\n    \n    Emergency &lt;|-- OxygenLeakEmergency\n    Emergency &lt;|-- FireEmergency\n    Emergency &lt;|-- RoverBreakdownEmergency\n    Emergency &lt;|-- MedicalEmergency\n    \n    EmergencyManager --&gt; Emergency : \&quot;Handles\&quot;\n    Main --&gt; Simulation : \&quot;Runs\&quot;\n}\n\n&#39; Cross-Module Relationships\nAgent --&gt; Location : \&quot;located at\&quot;\nFacility --&gt; Location : \&quot;located at\&quot;\nEmergency --&gt; Location : \&quot;occurs at\&quot;\nResourceManager --&gt; Facility : \&quot;manages\&quot;\nMarsColony --&gt; ResourceManager : \&quot;uses\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="G5F7AmoBoUTO1UhH76QN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
